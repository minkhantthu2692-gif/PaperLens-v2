{
  "name": "paperlens",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first document reconstruction workspace for PDFs, scans, and OCR output.",
  "type": "module",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "predev": "node scripts/sync-ocr-assets.mjs",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "prebuild": "node scripts/sync-ocr-assets.mjs",
    "postbuild": "node scripts/copy-spa-fallback.mjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "prepreview": "node scripts/sync-ocr-assets.mjs",
    "typecheck": "node ./node_modules/typescript/bin/tsc -b",
    "lint": "node ./node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "lint:fix": "node ./node_modules/eslint/bin/eslint.js . --fix",
    "format": "node ./node_modules/prettier/bin/prettier.cjs --write .",
    "format:check": "node ./node_modules/prettier/bin/prettier.cjs --check .",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "ocr:assets": "node scripts/sync-ocr-assets.mjs"
  },
  "dependencies": {
    "@tiptap/core": "^2.27.3",
    "@tiptap/extension-link": "^2.27.3",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-text-align": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "clsx": "^2.1.1",
    "docx": "^9.15.3",
    "dompurify": "^3.4.17",
    "i18next": "^23.15.0",
    "idb": "^8.0.4",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^0.454.0",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.0",
    "react-router-dom": "^6.30.6",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "fflate": "^0.8.3",
    "globals": "^15.10.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
